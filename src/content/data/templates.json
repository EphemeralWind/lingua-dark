{
  "version": 1,
  "dialect": "es-ES",
  "note": "Seed templates for Zone 1. Slot rule: verb.takes must intersect noun.tags. Milestone 2 added t_indefinite_plural, t_vocab_noun, t_translate_object, gloss_en, and excludeTags; all need native review.",
  "persons": [
    "yo",
    "tu",
    "el",
    "nosotros",
    "vosotros",
    "ellos"
  ],
  "pronouns": [
    {
      "id": "yo",
      "surface": "yo",
      "person": "yo",
      "gloss_en": "I"
    },
    {
      "id": "tu",
      "surface": "tú",
      "person": "tu",
      "gloss_en": "you"
    },
    {
      "id": "el",
      "surface": "él",
      "person": "el",
      "gloss_en": "he"
    },
    {
      "id": "ella",
      "surface": "ella",
      "person": "el",
      "gloss_en": "she"
    },
    {
      "id": "nosotros",
      "surface": "nosotros",
      "person": "nosotros",
      "gloss_en": "we"
    },
    {
      "id": "vosotros",
      "surface": "vosotros",
      "person": "vosotros",
      "gloss_en": "you all"
    },
    {
      "id": "ellos",
      "surface": "ellos",
      "person": "ellos",
      "gloss_en": "they"
    },
    {
      "id": "ellas",
      "surface": "ellas",
      "person": "ellos",
      "gloss_en": "they"
    }
  ],
  "articles": {
    "definite": {
      "m": {
        "sg": "el",
        "pl": "los"
      },
      "f": {
        "sg": "la",
        "pl": "las"
      }
    },
    "indefinite": {
      "m": {
        "sg": "un",
        "pl": "unos"
      },
      "f": {
        "sg": "una",
        "pl": "unas"
      }
    }
  },
  "templates": [
    {
      "id": "t_present_object",
      "zone": 1,
      "kind": "grammar",
      "pattern": "{subj} {verb:present} {art:definite}{noun}.",
      "slots": {
        "subj": {
          "type": "subject"
        },
        "verb": {
          "type": "verb"
        },
        "noun": {
          "type": "noun",
          "number": "sg",
          "requires": "verb.takes"
        },
        "art": {
          "type": "article",
          "agreesWith": "noun"
        }
      },
      "blanks": [
        "verb"
      ],
      "distractors": {
        "verb": {
          "vary": [
            "person"
          ]
        }
      },
      "tests": [
        "{verb}:present:{person}"
      ]
    },
    {
      "id": "t_definite_article",
      "zone": 1,
      "kind": "grammar",
      "pattern": "{subj} {verb:present} {art:definite}{noun}.",
      "slots": {
        "subj": {
          "type": "subject"
        },
        "verb": {
          "type": "verb"
        },
        "noun": {
          "type": "noun",
          "number": "sg",
          "requires": "verb.takes"
        },
        "art": {
          "type": "article"
        }
      },
      "blanks": [
        "art"
      ],
      "distractors": {
        "art": {
          "vary": [
            "gender",
            "number"
          ]
        }
      },
      "tests": [
        "art:definite:{gender}:sg"
      ]
    },
    {
      "id": "t_indefinite_article",
      "zone": 1,
      "kind": "grammar",
      "pattern": "{subj} {verb:present} {art:indefinite}{noun}.",
      "slots": {
        "subj": {
          "type": "subject"
        },
        "verb": {
          "type": "verb"
        },
        "noun": {
          "type": "noun",
          "number": "sg",
          "requires": "verb.takes",
          "excludeTags": [
            "mass"
          ]
        },
        "art": {
          "type": "article"
        }
      },
      "blanks": [
        "art"
      ],
      "distractors": {
        "art": {
          "vary": [
            "gender",
            "number"
          ]
        }
      },
      "tests": [
        "art:indefinite:{gender}:sg"
      ]
    },
    {
      "id": "t_plural_object",
      "zone": 1,
      "kind": "grammar",
      "pattern": "{subj} {verb:present} {art:definite}{noun:plural}.",
      "slots": {
        "subj": {
          "type": "subject"
        },
        "verb": {
          "type": "verb"
        },
        "noun": {
          "type": "noun",
          "number": "pl",
          "requires": "verb.takes",
          "excludeTags": [
            "mass"
          ]
        },
        "art": {
          "type": "article",
          "agreesWith": "noun"
        }
      },
      "blanks": [
        "art"
      ],
      "distractors": {
        "art": {
          "vary": [
            "gender",
            "number"
          ]
        }
      },
      "tests": [
        "art:definite:{gender}:pl",
        "{noun}:plural"
      ]
    },
    {
      "id": "t_combo_two",
      "zone": 1,
      "kind": "combo",
      "pattern": "{subj1} {verb1:present} {art1:definite}{noun1} y {subj2} {verb2:present} {art2:definite}{noun2}.",
      "slots": {
        "subj1": {
          "type": "subject"
        },
        "verb1": {
          "type": "verb"
        },
        "noun1": {
          "type": "noun",
          "number": "sg",
          "requires": "verb1.takes"
        },
        "art1": {
          "type": "article",
          "agreesWith": "noun1"
        },
        "subj2": {
          "type": "subject",
          "distinctPersonFrom": "subj1"
        },
        "verb2": {
          "type": "verb"
        },
        "noun2": {
          "type": "noun",
          "number": "sg",
          "requires": "verb2.takes",
          "distinctFrom": "noun1"
        },
        "art2": {
          "type": "article",
          "agreesWith": "noun2"
        }
      },
      "blanks": [
        "verb1",
        "verb2"
      ],
      "distractors": {
        "verb1": {
          "vary": [
            "person"
          ]
        },
        "verb2": {
          "vary": [
            "person"
          ]
        }
      },
      "tests": [
        "{verb1}:present:{person1}",
        "{verb2}:present:{person2}"
      ]
    },
    {
      "id": "t_indefinite_plural",
      "zone": 1,
      "kind": "grammar",
      "pattern": "{subj} {verb:present} {art:indefinite}{noun:plural}.",
      "slots": {
        "subj": {
          "type": "subject"
        },
        "verb": {
          "type": "verb"
        },
        "noun": {
          "type": "noun",
          "number": "pl",
          "requires": "verb.takes",
          "excludeTags": [
            "mass"
          ]
        },
        "art": {
          "type": "article",
          "agreesWith": "noun"
        }
      },
      "blanks": [
        "art"
      ],
      "distractors": {
        "art": {
          "vary": [
            "gender",
            "number"
          ]
        }
      },
      "tests": [
        "art:indefinite:{gender}:pl",
        "{noun}:plural"
      ]
    },
    {
      "id": "t_vocab_noun",
      "zone": 1,
      "kind": "vocab",
      "pattern": "{art:definite}{noun}",
      "gloss_en": "the {noun}",
      "slots": {
        "noun": {
          "type": "noun",
          "number": "sg"
        },
        "art": {
          "type": "article",
          "agreesWith": "noun"
        }
      },
      "blanks": [
        "$sentence"
      ],
      "distractors": {
        "$sentence": {
          "vary": [
            "lemma"
          ]
        }
      },
      "tests": [
        "{noun}"
      ]
    },
    {
      "id": "t_translate_object",
      "zone": 1,
      "kind": "translate",
      "pattern": "{subj} {verb:present} {art:definite}{noun}.",
      "gloss_en": "{subj} {verb} the {noun}.",
      "slots": {
        "subj": {
          "type": "subject"
        },
        "verb": {
          "type": "verb"
        },
        "noun": {
          "type": "noun",
          "number": "sg",
          "requires": "verb.takes"
        },
        "art": {
          "type": "article",
          "agreesWith": "noun"
        }
      },
      "blanks": [
        "$sentence"
      ],
      "distractors": {
        "$sentence": {
          "vary": [
            "person",
            "gender"
          ]
        }
      },
      "tests": [
        "{verb}:present:{person}",
        "art:definite:{gender}:sg"
      ]
    }
  ]
}
